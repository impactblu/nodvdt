# Save as a file named .env in Shared folder/docker/pcs-atlas on the NAS.
# Never commit the real .env to GitHub.

# Repository that holds the website (owner/name) and its branch.
GITHUB_REPO=impactblu/nodvdt
GIT_BRANCH=main

# Fine-grained personal access token:
#   Repository access: only impactblu/nodvdt
#   Permissions: Contents = Read and write (nothing else)
GITHUB_TOKEN=

# Commit author for the collector's pushes. Vercel only deploys commits from an
# author it recognises, so use the same name and email as in the LT2 watcher's
# .env (the email linked to your GitHub and Vercel accounts).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# How often to check supplier websites.
CHECK_INTERVAL_HOURS=24

# Politeness and safety limits for downloads.
REQUEST_DELAY_SECONDS=2
MAX_FILE_MB=40

# Set to false to collect and commit without pushing (a dry run).
PUSH_CHANGES=true
